{
  "name": "linkedin-posts-job-radar-mcp",
  "version": "2.0.0",
  "description": "MCP server that harvests employer job posts from LinkedIn, screens them by market and relevance, and tracks them in a local dashboard.",
  "main": "build/main.js",
  "type": "module",
  "bin": {
    "linkedin-posts-job-radar-mcp": "build/main.js"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf build",
    "build": "npm run clean && tsc && npm run build-viewer && npm run copy-viewer",
    "build-viewer": "cd src/viewer/app && npm run build",
    "copy-viewer": "cpx \"src/viewer/app/dist/**/*\" build/viewer/web",
    "dev": "tsx src/main.ts",
    "start": "node build/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup": "npm install && npm run setup-viewer && echo \"Server and viewer dependencies installed.\"",
    "setup-viewer": "cd src/viewer/app && npm install",
    "viewer": "node scripts/serve-viewer.mjs",
    "seed": "node scripts/seed-from-export.mjs",
    "rederive": "node scripts/rederive-fields.mjs",
    "harvest:probe": "tsx src/linkedin/harvest/dev-harness.ts",
    "pack": "npx @anthropic-ai/mcpb pack",
    "bundle": "npm run build && npm run pack",
    "prepare": "npm run setup-viewer && npm run build",
    "prepublishOnly": "npm run build",
    "postinstall": "playwright install --with-deps chromium"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "linkedin",
    "job-search",
    "playwright",
    "scraping",
    "sqlite",
    "react",
    "claude"
  ],
  "author": {
    "name": "MaryemeBay",
    "url": "https://github.com/MaryemeBay"
  },
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "cors": "^2.8.5",
    "cpx2": "^7.0.1",
    "express": "^5.1.0",
    "open": "^10.1.0",
    "playwright": "^1.55.1",
    "sql.js": "^1.12.0",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/open": "^6.1.0",
    "@types/sql.js": "^1.4.9",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "contributors": [
    {
      "name": "Kevin Weitgenant",
      "url": "https://github.com/kevin-weitgenant",
      "comment": "Original author of LinkedIn-Posts-Hunter-MCP-Server, which this project is derived from"
    }
  ]
}
