# ---------------------------------------------------------------------------
# Local data — never commit these.
#
# The harvested database, the LinkedIn session and any scrape exports live in
# ~/.linkedin-mcp/ , outside this repo, so they are already out of git's reach.
# These patterns are a second line of defence in case a copy is ever made here.
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.bak
auth.json
filter-state.json
results*.json
scripts/linkedin_posts.json
screenshots/
searches/
playwright/storage/

# Scratch files from debugging sessions
*.tmp.*
debug-*.png

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Caches and build metadata
*.tsbuildinfo
.npm
.eslintcache
.cache/

